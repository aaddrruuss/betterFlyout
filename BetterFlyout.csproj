<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.19041.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <AssemblyName>BetterFlyout</AssemblyName>
    <RootNamespace>BetterFlyout</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <Version>1.0.0</Version>
    <Product>BetterFlyout</Product>
    <Authors>aaddrruuss</Authors>
    <Copyright>Copyright (C) 2026 aaddrruuss</Copyright>
    <PackageLicenseExpression>GPL-3.0-or-later</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/aaddrruuss/</PackageProjectUrl>
    <NoWarn>$(NoWarn);WPF0001</NoWarn>
  </PropertyGroup>

  <!-- dotnet publish -c Release -p:UIAccess=true  -> ventana en banda UIAccess (por encima de juegos). Requiere firma + Program Files. -->
  <PropertyGroup Condition="'$(UIAccess)' == 'true'">
    <ApplicationManifest>app.uiaccess.manifest</ApplicationManifest>
    <DefineConstants>$(DefineConstants);UIACCESS</DefineConstants>
    <!-- Carpetas separadas: el exe UIAccess solo arranca firmado y en Program Files,
         asi que no debe mezclarse con bin\Release normal. -->
    <OutputPath>bin\uiaccess\$(Configuration)\</OutputPath>
    <IntermediateOutputPath>obj\uiaccess\$(Configuration)\</IntermediateOutputPath>
  </PropertyGroup>

</Project>
